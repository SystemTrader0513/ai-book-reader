{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentara.local/web-test-assistant/requirement.schema.json",
  "title": "Web Test Requirements",
  "type": "object",
  "required": ["schemaVersion", "mode", "source", "requirements"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "mode": {"enum": ["requirement-validation", "characterization"]},
    "source": {
      "type": "object",
      "required": ["path", "type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"enum": ["markdown", "text"]}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirementId", "title", "status", "priority", "preconditions", "testData", "steps"],
        "properties": {
          "requirementId": {"type": "string", "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "needs_clarification", "unsupported"]},
          "priority": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "testData": {"type": "object"},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": {"type": "string", "minLength": 1},
                "expected": {"type": "string", "minLength": 1}
              }
            }
          },
          "clarificationQuestions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
